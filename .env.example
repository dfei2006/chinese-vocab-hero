# Optional. Needed only for server-side speech transcription.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional, and preferred if you have it. Used for worksheet photo OCR and silly sentences.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoMultilingualNeural

# Optional. Use this if your VPN app exposes a local HTTP proxy.
# Common examples: http://127.0.0.1:7890, http://127.0.0.1:6152, http://127.0.0.1:8080
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

PORT=4173
