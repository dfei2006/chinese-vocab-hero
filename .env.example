# Optional. Needed for worksheet photo OCR, AI-generated sentences, and server transcription.
# If you only have ChatGPT/OAuth login, leave this blank and use manual entry.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoMultilingualNeural

PORT=4173
