# Optional. Needed only for server-side speech transcription.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional, and preferred if you have it. Used for worksheet photo OCR and silly sentences.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoMultilingualNeural

# Alternative to Azure. 火山引擎 / 豆包 TTS.
# Set TTS_PROVIDER=volcengine to use this path.
TTS_PROVIDER=
VOLCENGINE_TTS_APP_ID=
# New console / API Key mode.
VOLCENGINE_TTS_ACCESS_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
# Old console / Access Token mode.
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE_TYPE=S_nNepq2X22

# Optional live reward chat. Use the APP ID and Access Token from 豆包端到端实时语音大模型.
VOLCENGINE_REALTIME_APP_ID=
VOLCENGINE_REALTIME_ACCESS_TOKEN=
# API Key alias also accepted, but Access Token is preferred for realtime.
VOLCENGINE_REALTIME_ACCESS_KEY=
VOLCENGINE_REALTIME_SPEAKER=S_nNepq2X22

# Optional. Use this if your VPN app exposes a local HTTP proxy.
# Common examples: http://127.0.0.1:7890, http://127.0.0.1:6152, http://127.0.0.1:8080
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

PORT=4173
